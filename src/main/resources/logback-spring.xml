<configuration>
    <appender name="bankBranchDetailsConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg %n
            </pattern>
        </encoder>
    </appender>

    <appender name="bankBranchDetailsFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>
            /var/log/banking-system-logs/bankBrnachDetails.log
        </file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>bankBrnachDetails-%d{yy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>
                %d{yy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg %n
            </pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="bankBranchDetailsConsoleAppender" />
        <appender-ref ref="bankBranchDetailsFileAppender" />
    </root>
</configuration>